# CourtHub API (Spring Boot) — variables de entorno
# Con Docker Compose estas variables se inyectan automáticamente.
# Para ejecutar sin Docker, expórtalas en tu terminal o configúralas en tu IDE.
PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=courthub
PGPASSWORD=courthub
PGDATABASE=courthub

# Seguridad
JWT_SECRET=cambia-esta-clave-secreta-en-produccion

# Cargar datos demo (db/seed.sql) si la BD está vacía
SEED_DEMO=true

# Inicio de sesión con Google (opcional). Crea credenciales OAuth 2.0 (tipo Aplicación web) en
# https://console.cloud.google.com/apis/credentials y registra el URI de redirección:
#   http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
